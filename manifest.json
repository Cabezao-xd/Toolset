{
  "manifestVersion": 1,
  "name": "Talespire 5e Toolset Prototype",
  "summary": "A VTT like experience for Talespire",
  "descriptionFilePath": "/README.md",
  "version": "0.7.7",
  "license": "MIT",
  "about": {
    "website": "",
    "authors": ["illume63"]
  },
  "kind": "webView",
  "entryPoint": "/dist-v2/v2.html",
  "api": {
    "version": "0.1",
    "initTimeout": 5,
    "subscriptions": {
      "dice": {
        "onRollResults": "handleRollResult"
      },
      "symbiote": {
        "onVisibilityEvent": "logSymbioteEvent",
        "onStateChangeEvent": "onStateChangeEvent"
      },
      "creatures": {
        "onCreatureStateChange": "onCreatureStateChange"
      },
      "sync": {
        "onSyncMessage": "handleSyncEvents",
        "onClientEvent": "handleSyncClientEvents"
      },
      "clients": {
        "onClientEvent": "handleClientEvents"
      },
      "players": {
        "onCampaignPlayerEvent": "handlePlayerPermissionEvents"
      },
      "chat": {
        "onChatMessage": "handleChatMessage"
      }
    },
    "interop": {
      "id": "77854b0b-c2d0-422d-8608-37baa1754ead"
    }
  },
  "controls": {
    "reload": true
  },
  "environment": {
    "capabilities": [
      "playAudio",
      "runInBackground"
    ],
    "extras": [
      "icons",
      "fonts",
      "colorStyles"
    ],
    "webViewBackgroundColor": "#121711",
    "symbiote_width": "100%"
  }
}