pe":"none"}},{"id":"trt_f385a08bceba4445985c0749e9716964","order":3,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Draconic Ancestry","cheveron":true,"traitDescription":"Your lineage stems from a dragon progenitor. Choose the kind of dragon from the Draconic Ancestors table. Your choice affects your Breath Weapon and Damage Resistance traits as well as your appearance.\r\n\r\nDraconic Ancestors\r\n\nDragon\r\nDamage Type\r\n\nBlack\r\nAcid\r\n\nBlue\r\nLightning\r\n\nBrass\r\nFire\r\n\nBronze\r\nLightning\r\n\nCopper\r\nAcid\r\n\nGold\r\nFire\r\n\nGreen\r\nPoison\r\n\nRed\r\nFire\r\n\nSilver\r\nCold\r\n\nWhite\r\nCold","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_092217fd53dc547d7bf186254f0008e8","order":4,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Breath Weapon","cheveron":true,"traitDescription":"When you take the Attack action on your turn, you can replace one of your attacks with an exhalation of magical energy in either a 15-foot Cone or a 30-foot Line that is 5 feet wide (choose the shape each time). Each creature in that area must make a Dexterity saving throw (DC 8 plus your Constitution modifier and Proficiency Bonus). On a failed save, a creature takes 1d10 damage of the type determined by your Draconic Ancestry trait. On a successful save, a creature takes half as much damage. This damage increases by 1d10 when you reach character levels 5 (2d10), 11 (3d10), and 17 (4d10).\r\nYou can use this Breath Weapon a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_7e9dbd595fafa6d5bfd93c4d181de631","order":5,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Damage Resistance","cheveron":true,"traitDescription":"You have Resistance to the damage type determined by your Draconic Ancestry trait.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_0a626e6a7bfa57098c9d991ab3a2b052","order":6,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Darkvision","cheveron":true,"traitDescription":"You have Darkvision with a range of 60 feet.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_5e076936e8190c74dc9b67e70b0b462c","order":7,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Draconic Flight","cheveron":true,"traitDescription":"When you reach character level 5, you can channel draconic magic to give yourself temporary flight. As a Bonus Action, you sprout spectral wings on your back that last for 10 minutes or until you retract the wings (no action required) or have the Incapacitated condition. During that time, you have a Fly Speed equal to your Speed. Your wings appear to be made of the same energy as your Breath Weapon. Once you use this trait, you can’t use it again until you finish a Long Rest.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_dd9007c73ee3e478ab68a44dae192fb5","order":8,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Ability Score Increases","cheveron":true,"traitDescription":"When determining your character’s ability scores, increase one score by 2 and a different one by 1, or increase three scores by 1. None of these increases can raise a score above 20.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_0c6348aad1e96c4e415f8208daea8bf6","order":9,"group":"Racial Traits","legacyId":null,"data":{"traitName":"Languages","cheveron":true,"traitDescription":"Your character knows at least three languages: Common plus two languages you roll or choose from the Standard Languages table. Knowledge of a language means your character can communicate in it, read it, and write it. Your class and other features might also give you languages.\r\nThe Standard Languages table lists languages that are widespread on D&D worlds. Every player character knows Common, which originated in the planar metropolis of Sigil, the hub of the multiverse. The other standard languages originated with the first members of the most prominent species in the worlds of D&D and have since spread widely.\r\nStandard Languages\r\n\n1d12\r\nLanguage\r\nOrigin\r\n\n&mdash;\r\nCommon\r\nSigil\r\n\n1\r\nCommon Sign Language\r\nSigil\r\n\n2\r\nDraconic\r\nDragons\r\n\n3-4\r\nDwarvish\r\nDwarves\r\n\n5-6\r\nElvish\r\nElves\r\n\n7\r\nGiant\r\nGiants\r\n\n8\r\nGnomish\r\nGnomes\r\n\n9\r\nGoblin\r\nGoblinoids\r\n\n10-11\r\nHalfling\r\nHalflings\r\n\n12\r\nOrc\r\nOrcs","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}}]},{"id":"trg_4035446596cd650b3eb8d0d76472de20","order":2,"title":"Class Traits","collapsed":false,"data":{"group-title":"Class Traits","group-chevron":false},"items":[{"id":"trt_646e2a021123bfcba84bf0cdccf1d790","order":0,"group":"Class Traits","legacyId":null,"data":{"traitName":"Core Monk Traits","cheveron":true,"traitDescription":"As a Level 1 Character:\r\n\r\nGain all the traits in the Core Monk Traits table.\r\nGain the Monk’s level 1 features.\r\n\r\nCore Monk Traits\r\n\nPrimary Ability\r\nDexterity and Wisdom\r\n\nHit Point Die\r\nD8 per Monk level\r\n\nSaving Throw Proficiencies\r\nStrength and Dexterity\r\n\nSkill Proficiencies\r\nChoose 2: Acrobatics, Athletics, History, Insight, Religion, or Stealth\r\n\nWeapon Proficiencies\r\nSimple weapons and Martial weapons that have the Light property\r\n\nTool Proficiencies\r\nChoose one type of Artisan’s Tools or Musical Instrument\r\n\nArmor Training\r\nNone\r\n\nStarting Equipment\r\nChoose A or B: (A) Spear, 5 Daggers, Artisan’s Tools or Musical Instrument chosen for the tool proficiency above, Explorer’s Pack, and 11 GP; or (B) 50 GP","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_3e928afa8a174d93d12cb9bc4fae31c4","order":1,"group":"Class Traits","legacyId":null,"data":{"traitName":"Martial Arts","cheveron":true,"traitDescription":"Your practice of martial arts gives you mastery of combat styles that use your Unarmed Strike and Monk weapons, which are the following:\r\n\r\nSimple Melee weapons\r\nMartial Melee weapons that have the Light property\r\n\r\nYou gain the following benefits while you are unarmed or wielding only Monk weapons and you aren’t wearing armor or wielding a Shield.\r\nBonus Unarmed Strike. You can make an Unarmed Strike as a Bonus Action.\r\nMartial Arts Die. You can roll 1d6 in place of the normal damage of your Unarmed Strike or Monk weapons. This die changes as you gain Monk levels, as shown in the Martial Arts column of the Monk Features table.\r\nDexterous Attacks. You can use your Dexterity modifier instead of your Strength modifier for the attack and damage rolls of your Unarmed Strikes and Monk weapons. In addition, when you use the Grapple or Shove option of your Unarmed Strike, you can use your Dexterity modifier instead of your Strength modifier to determine the save DC.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}},{"id":"trt_36f16ed626750a0cd7d9f7d27313e3e8","order":2,"group":"Class Traits","legacyId":null,"data":{"traitName":"Unarmored Defense","cheveron":true,"traitDescription":"While you aren’t wearing armor or wielding a Shield, your base Armor Class equals 10 plus your Dexterity and Wisdom modifiers.","checkboxStates":[],"numberOfUses":"0","adjustmentCategory":"None","adjustmentSubCategory":"","adjustmentAbility":"NONE","adjustmentValue":"0","resetType":"none"}}]}],"notes":[],"extras":[]},"legacy":{"sourceKey":"Draekarion","unmapped":{"pb-1":1,"pb-2":0,"pb-3":0,"pb-4":1,"pb-5":0,"pb-6":0,"pb-7":0,"pb-8":1,"pb-9":0,"pb-10":0,"pb-11":0,"pb-12":0,"pb-13":0,"pb-14":0,"pb-15":0,"pb-16":0,"pb-17":1,"pb-18":0,"pb-19":1,"pb-20":1,"pb-21":0,"pb-22":0,"pb-23":0,"pb-24":0}},"metadata":{"createdAt":"2026-09-19T02:59:42.568Z","updatedAt":"2026-09-19T02:59:42.568Z","migratedFrom":"v1"}},"chr_a5ea8e1f1af71f2dc9a4dcf2a94f09c0":{"schemaVersion":2,"id":"chr_a5ea8e1f1af71f2dc9a4dcf2a94f09c0","revision":0,"name":"Draekarion","color":"#a88bd4","identity":{"className":"Monk","level":1,"experience":0,"alignment":""},"abilities":{"strength":12,"dexterity":17,"constitution":14,"intelligence":10,"wisdom":14,"charisma":8},"combat":{"armorClass":10,"speed":"30","initiative":"3","hitPoints":{"current":10,"maximum":10,"temporary":0},"hitDice":{"current":"1","formula":"1d8","remaining":1,"maximum":1,"dieSize":8},"deathSaves":{"successes":0,"failures":0},"conditions":[],"inspiration":false,"exhaustion":0},"proficiencies":{"weapons":["Simple Weapons","Shortsword","Crossbow, Hand"],"armor":[],"languages":["Common","Draconic","Elvish"],"tools":["Calligrapher's Supplies","Dragonchess Set"]},"checks":{"skills":{"acrobatics":{"proficiency":1,"bonus":0,"rollMode":"normal"},"animalHandling":{"proficiency":0,"bonus":0,"rollMode":"normal"},"arcana":{"proficiency":0,"bonus":0,"rollMode":"normal"},"athletics":{"proficiency":1,"bonus":0,"rollMode":"normal"},"deception":{"proficiency":0,"bonus":0,"rollMode":"normal"},"history":{"proficiency":0,"bonus":0,"rollMode":"normal"},"insight":{"proficienc